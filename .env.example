# Copy to .env and adjust. Never commit .env (it is gitignored).

# ComfyUI HTTP API endpoint (ComfyUI runs as a separate process)
GAS_COMFYUI_BASE_URL=http://127.0.0.1:8188

# Directory for run artifacts and intermediate data (gitignored)
GAS_RUNS_DIR=runs
GAS_DATA_DIR=data

# DEBUG | INFO | WARNING | ERROR
GAS_LOG_LEVEL=INFO
